# Google Search Console API（サービスアカウント JSON を1行で、またはファイルパス）
# GSC 各プロパティにサービスアカウントのメールを「所有者」または「フル」で追加すること
GSC_SERVICE_ACCOUNT_JSON=
# または
# GOOGLE_APPLICATION_CREDENTIALS=./google-service-account.json

# IndexNow（サイトごとに sites.json の indexNowKey でも可）
# INDEXNOW_KEY=

# 状態ファイル（省略時: .sitemap-auto/state.json）
# SITEMAP_AUTO_STATE=./.sitemap-auto/state.json

# 設定ファイル（省略時: ./sites.json）
# SITEMAP_AUTO_CONFIG=./sites.json
