+<?php
+
+namespace App\Services;
+
+class DtiRssClient
+{
+    public function __construct(private readonly string $affiliateId)
+    {
+    }
+
+    /**
+     * @return array<int, array{
+     *     movieId: string,
+     *     title: string,
+     *     description: string,
+     *     actress: ?string,
+     *     affiliateUrl: string,
+     *     pageUrl: ?string,
+     *     siteName: ?string,
+     *     publishedAt: ?string
+     * }>
+     */
+    public function fetchMovieItems(): array
+    {
+        $url = "https://ad2widget.dtiserv2.com/rss?aid={$this->affiliateId}";
+        $context = stream_context_create(['http' => ['timeout' => 20]]);
+        $raw = @file_get_contents($url, false, $context);
+
+        if ($raw === false) {
+            return [];
+        }
+
+        $xml = @simplexml_load_string($raw);
+
+        if ($xml === false) {
+            return [];
+        }
+
+        $namespaces = $xml->getNamespaces(true);
+        $dtiNs = $namespaces['dtiaff'] ?? 'http://pixel-vault.com/ns/1.0';
+        $items = [];
+
+        foreach ($xml->channel->item as $item) {
+            $movieNode = $item->children($dtiNs)->movie ?? null;
+
+            if ($movieNode === null) {
+                continue;
+            }
+
+            $movieId = trim((string) ($movieNode->movie_id ?? ''));
+
+            if ($movieId === '') {
+                continue;
+            }
+
+            $affiliateUrl = trim((string) $item->link);
+            $pageUrl = CaribbeancomSampleResolver::officialPageUrl($affiliateUrl);
+
+            if ($pageUrl === null) {
+                continue;
+            }
+
+            $items[] = [
+                'movieId' => $movieId,
+                'title' => trim((string) $item->title),
+                'description' => trim((string) $item->description),
+                'actress' => trim((string) ($movieNode->actor_name ?? '')) ?: null,
+                'affiliateUrl' => $affiliateUrl,
+                'pageUrl' => $pageUrl,
+                'siteName' => CaribbeancomSampleResolver::siteName($affiliateUrl),
+                'publishedAt' => trim((string) $item->pubDate) ?: null,
+            ];
+        }
+
+        return $items;
+    }
+}
