+<?php
+
+namespace App\Services;
+
+class CaribbeancomSampleResolver
+{
+    public static function siteName(string $affiliateUrl): ?string
+    {
+        if (str_contains($affiliateUrl, 'caribbeancom')) {
+            return 'カリビアンコム';
+        }
+
+        return null;
+    }
+
+    public static function officialPageUrl(string $affiliateUrl): ?string
+    {
+        if (! preg_match('#/moviepages/([^/]+)/index\.html#', $affiliateUrl, $matches)) {
+            return null;
+        }
+
+        $movieCode = $matches[1];
+
+        if (! str_contains($affiliateUrl, 'caribbeancom') && ! preg_match('/^\d{6}-\d{3}$/', $movieCode)) {
+            return null;
+        }
+
+        return "http://www.caribbeancom.com/moviepages/{$movieCode}/index.html";
+    }
+
+    public static function sampleMp4Url(string $pageUrl): ?string
+    {
+        if (! preg_match('#/moviepages/([^/]+)/index\.html#', $pageUrl, $matches)) {
+            return null;
+        }
+
+        return "http://smovie.caribbeancom.com/sample/movies/{$matches[1]}/sample_m.mp4";
+    }
+
+    public static function sampleMp4Exists(string $pageUrl): bool
+    {
+        $sampleUrl = self::sampleMp4Url($pageUrl);
+
+        if ($sampleUrl === null) {
+            return false;
+        }
+
+        $context = stream_context_create([
+            'http' => [
+                'method' => 'HEAD',
+                'timeout' => 10,
+                'ignore_errors' => true,
+            ],
+        ]);
+
+        $headers = @get_headers($sampleUrl, true, $context);
+
+        if ($headers === false) {
+            return false;
+        }
+
+        $statusLine = is_array($headers[0] ?? null) ? $headers[0][0] : ($headers[0] ?? '');
+
+        return str_contains($statusLine, '200');
+    }
+}
