+<?php
+
+namespace App\Console\Commands;
+
+use App\Models\SampleItem;
+use App\Services\CaribbeancomSampleResolver;
+use App\Services\ContentSafetyFilter;
+use App\Services\DtiRssClient;
+use Illuminate\Console\Command;
+
+class SyncDtiSamples extends Command
+{
+    protected $signature = 'samples:sync-dti {--verify-sample : HEAD-check sample MP4 URLs before storing}';
+
+    protected $description = 'Fetch DTI RSS movie items for Caribbeancom and store playable sample MP4 URLs';
+
+    public function handle(DtiRssClient $client): int
+    {
+        $items = $client->fetchMovieItems();
+        $seen = [];
+        $verifySample = (bool) $this->option('verify-sample');
+
+        foreach ($items as $item) {
+            $pageUrl = $item['pageUrl'];
+
+            if ($pageUrl === null) {
+                continue;
+            }
+
+            $sampleUrl = CaribbeancomSampleResolver::sampleMp4Url($pageUrl);
+
+            if ($sampleUrl === null) {
+                continue;
+            }
+
+            if ($verifySample && ! CaribbeancomSampleResolver::sampleMp4Exists($pageUrl)) {
+                continue;
+            }
+
+            if (! ContentSafetyFilter::isSafe($item['title'], $item['description'], (string) $item['actress'])) {
+                continue;
+            }
+
+            $seen[] = $item['movieId'];
+
+            SampleItem::updateOrCreate(
+                ['content_id' => $item['movieId']],
+                [
+                    'source' => 'dti',
+                    'title' => $item['title'],
+                    'maker' => $item['siteName'],
+                    'site_name' => $item['siteName'],
+                    'actress' => $item['actress'],
+                    'description' => mb_substr($item['description'], 0, 500),
+                    'genre' => null,
+                    'image_url' => null,
+                    'sample_url' => $sampleUrl,
+                    'sample_media_type' => 'mp4',
+                    'url' => $pageUrl,
+                    'affiliate_url' => $item['affiliateUrl'],
+                    'review_average' => null,
+                    'review_count' => 0,
+                ]
+            );
+        }
+
+        if (! empty($seen)) {
+            SampleItem::where('source', 'dti')->whereNotIn('content_id', $seen)->delete();
+        }
+
+        $this->info('Synced ' . count($seen) . ' DTI sample items.');
+
+        return self::SUCCESS;
+    }
+}
