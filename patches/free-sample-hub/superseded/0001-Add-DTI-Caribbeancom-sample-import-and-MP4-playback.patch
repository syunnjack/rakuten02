+<?php
+
+namespace App\Console\Commands;
+
+use App\Models\SampleItem;
+use App\Services\CaribbeancomSampleResolver;
+use App\Services\ContentSafetyFilter;
+use Illuminate\Console\Command;
+
+class ImportMovieCsv extends Command
+{
+    protected $signature = 'samples:import-csv {path : Path to a CSV file exported from DTI affiliate tools}';
+
+    protected $description = 'Import movie rows from a DTI-style CSV (movie_id,site_id,site_name,...)';
+
+    public function handle(): int
+    {
+        $path = $this->argument('path');
+
+        if (! is_readable($path)) {
+            $this->error("Cannot read CSV file: {$path}");
+
+            return self::FAILURE;
+        }
+
+        $handle = fopen($path, 'r');
+
+        if ($handle === false) {
+            $this->error("Cannot open CSV file: {$path}");
+
+            return self::FAILURE;
+        }
+
+        $header = fgetcsv($handle);
+
+        if ($header === false) {
+            fclose($handle);
+            $this->error('CSV file is empty.');
+
+            return self::FAILURE;
+        }
+
+        $header = array_map(fn ($column) => trim((string) $column), $header);
+        $imported = 0;
+
+        while (($row = fgetcsv($handle)) !== false) {
+            if (count($row) !== count($header)) {
+                continue;
+            }
+
+            $record = array_combine($header, $row);
+
+            if ($record === false) {
+                continue;
+            }
+
+            if ($this->importRow($record)) {
+                $imported++;
+            }
+        }
+
+        fclose($handle);
+
+        $this->info("Imported {$imported} sample item(s).");
+
+        return self::SUCCESS;
+    }
+
+    /**
+     * @param array<string, string|null> $row
+     */
+    private function importRow(array $row): bool
+    {
+        $movieId = trim((string) ($row['movie_id'] ?? ''));
+
+        if ($movieId === '') {
+            return false;
+        }
+
+        $title = trim((string) ($row['title'] ?? ''));
+        $description = trim((string) ($row['description'] ?? ''));
+        $actress = trim((string) ($row['actress'] ?? '')) ?: null;
+        $siteName = trim((string) ($row['site_name'] ?? '')) ?: null;
+        $pageUrl = trim((string) ($row['sample_url'] ?? ''));
+        $affiliateUrl = trim((string) ($row['aff_link'] ?? ''));
+        $sampleUrl = trim((string) ($row['sample_movie_url_2'] ?? ''));
+
+        if ($sampleUrl === '' && $pageUrl !== '') {
+            $sampleUrl = CaribbeancomSampleResolver::sampleMp4Url($pageUrl) ?? '';
+        }
+
+        if ($title === '' || $sampleUrl === '' || $affiliateUrl === '') {
+            return false;
+        }
+
+        if (! ContentSafetyFilter::isSafe($title, $description, (string) $actress)) {
+            return false;
+        }
+
+        SampleItem::updateOrCreate(
+            ['content_id' => $movieId],
+            [
+                'source' => 'dti',
+                'title' => $title,
+                'maker' => $siteName,
+                'site_name' => $siteName,
+                'actress' => $actress,
+                'description' => mb_substr($description, 0, 500),
+                'genre' => null,
+                'image_url' => null,
+                'sample_url' => $sampleUrl,
+                'sample_media_type' => 'mp4',
+                'url' => $pageUrl !== '' ? $pageUrl : CaribbeancomSampleResolver::officialPageUrl($affiliateUrl),
+                'affiliate_url' => $affiliateUrl,
+                'review_average' => null,
+                'review_count' => 0,
+            ]
+        );
+
+        return true;
+    }
+}
