+services:
+  - type: web
+    name: machi-list
+    runtime: static
+    buildCommand: npm run generate
+    staticPublishPath: .
+    domains:
+      - machi-list.jp
+      - www.machi-list.jp
+    envVars:
+      - key: NODE_VERSION
+        value: "22"
+      - key: GOOGLE_ANALYTICS_MEASUREMENT_ID
+        sync: false
+      - key: GOOGLE_SITE_VERIFICATION
+        sync: false
