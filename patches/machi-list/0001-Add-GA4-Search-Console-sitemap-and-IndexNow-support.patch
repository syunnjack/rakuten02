+++ b/.github/workflows/indexnow.yml
@@ -0,0 +1,33 @@
+name: IndexNow
+
+on:
+  push:
+    branches:
+      - main
+  workflow_dispatch:
+
+jobs:
+  submit:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Wait for deployment
+        run: |
+          set +e
+          for i in $(seq 1 30); do
+            if curl -fsS https://machi-list.jp/sitemap.xml | grep -q '<lastmod>'; then
+              echo "Deployment ready"
+              exit 0
+            fi
+            echo "Waiting for deployment... ($i/30)"
+            sleep 20
+          done
+          echo "Timed out waiting for deployment; submitting URLs anyway"
+
+      - name: Submit URLs to IndexNow
+        env:
+          INDEXNOW_KEY: ${{ secrets.INDEXNOW_KEY }}
+        run: |
+          KEY="${INDEXNOW_KEY:-machilistindex2026}"
+          curl -fsS -X POST "https://api.indexnow.org/indexnow" \
+            -H "Content-Type: application/json; charset=utf-8" \
+            -d "{\"host\":\"machi-list.jp\",\"key\":\"${KEY}\",\"keyLocation\":\"https://machi-list.jp/${KEY}.txt\",\"urlList\":[\"https://machi-list.jp/\",\"https://machi-list.jp/category/\"]}"
