+    /**
+     * DTI feeds and CSV exports still carry http:// links, which browsers block as
+     * mixed content once the page itself is served over https.
+     */
+    public static function secureUrl(string $url): string
+    {
+        if (! str_starts_with($url, 'http://')) {
+            return $url;
+        }
+
+        $host = parse_url($url, PHP_URL_HOST);
+
+        if (! is_string($host)) {
+            return $url;
+        }
+
+        foreach (['caribbeancom.com', 'caribbeancompr.com', 'heyzo.com'] as $domain) {
+            if ($host === $domain || str_ends_with($host, '.' . $domain)) {
+                return 'https://' . substr($url, strlen('http://'));
+            }
+        }
+
+        return $url;
+    }
