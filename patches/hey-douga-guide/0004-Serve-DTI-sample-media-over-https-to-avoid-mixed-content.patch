diff --git a/tests/Unit/DtiSampleResolverTest.php b/tests/Unit/DtiSampleResolverTest.php
new file mode 100644
index 0000000..541c875
--- /dev/null
+++ b/tests/Unit/DtiSampleResolverTest.php
@@ -0,0 +1,51 @@
+<?php
+
+namespace Tests\Unit;
+
+use App\Services\DtiSampleResolver;
+use PHPUnit\Framework\TestCase;
+
+class DtiSampleResolverTest extends TestCase
+{
+    public function test_it_derives_https_page_sample_and_thumbnail_urls(): void
+    {
+        $affiliate = 'https://click.dtiserv2.com/Direct/162667/www.caribbeancom.com/moviepages/080626-001/index.html';
+        $page = DtiSampleResolver::officialPageUrl($affiliate);
+
+        $this->assertSame('https://www.caribbeancom.com/moviepages/080626-001/index.html', $page);
+        $this->assertSame(
+            'https://smovie.caribbeancom.com/sample/movies/080626-001/sample_m.mp4',
+            DtiSampleResolver::sampleMp4Url($page)
+        );
+        $this->assertSame(
+            'https://www.caribbeancom.com/moviepages/080626-001/images/l_l.jpg',
+            DtiSampleResolver::thumbnailUrl($page)
+        );
+    }
+
+    public function test_it_upgrades_known_http_hosts_and_leaves_others_alone(): void
+    {
+        $this->assertSame(
+            'https://smovie.caribbeancom.com/sample/movies/080626-001/sample_m.mp4',
+            DtiSampleResolver::secureUrl('http://smovie.caribbeancom.com/sample/movies/080626-001/sample_m.mp4')
+        );
+        $this->assertSame(
+            'https://www.heyzo.com/contents/3000/3754/gallery/001.jpg',
+            DtiSampleResolver::secureUrl('http://www.heyzo.com/contents/3000/3754/gallery/001.jpg')
+        );
+        $this->assertSame(
+            'http://example.com/sample.mp4',
+            DtiSampleResolver::secureUrl('http://example.com/sample.mp4')
+        );
+        $this->assertSame(
+            'http://notcaribbeancom.com/sample.mp4',
+            DtiSampleResolver::secureUrl('http://notcaribbeancom.com/sample.mp4')
+        );
+    }
+
+    public function test_it_ignores_urls_without_a_movie_page_path(): void
+    {
+        $this->assertNull(DtiSampleResolver::movieCode('https://www.caribbeancom.com/listpages/all1.htm'));
+        $this->assertNull(DtiSampleResolver::sampleMp4Url('https://www.caribbeancom.com/'));
+    }
+}
