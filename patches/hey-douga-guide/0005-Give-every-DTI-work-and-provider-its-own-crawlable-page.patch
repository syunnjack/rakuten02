+
+@push('structured_data')
+@if($page > 1)
+<link rel="prev" href="{{ $pageUrl($page - 1) }}">
+@endif
+@if($items->hasMorePages())
+<link rel="next" href="{{ $pageUrl($page + 1) }}">
+@endif
+<script type="application/ld+json">{!! json_encode([
+    '@context' => 'https://schema.org',
