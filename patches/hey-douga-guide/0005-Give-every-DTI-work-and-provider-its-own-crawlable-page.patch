+  $page = $items->currentPage();
+  $pageSuffix = $page > 1 ? '（'.$page.'ページ）' : '';
+  // The paginator builds URLs from the request host, which would undo the APP_URL
+  // canonical host, and it writes ?page=1 for the first page instead of the bare path.
+  $pageUrl = fn (int $number) => $number <= 1
+      ? url('/sites/'.$slug)
+      : url('/sites/'.$slug).'?page='.$number;
+@endphp
+
+@section('title', $siteName.'のサンプル動画一覧'.$pageSuffix.'｜Hey動画ガイド')
