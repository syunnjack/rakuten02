diff --git a/app/Http/Controllers/DtiController.php b/app/Http/Controllers/DtiController.php
index 62c892f..7507b73 100644
--- a/app/Http/Controllers/DtiController.php
+++ b/app/Http/Controllers/DtiController.php
@@ -15,6 +15,48 @@ public function index()
 
         $lastUpdated = DtiItem::max('updated_at');
 
-        return view('welcome', compact('items', 'lastUpdated'));
+        return view('welcome', [
+            'items' => $items,
+            'lastUpdated' => $lastUpdated,
+            'sites' => DtiItem::siteSummaries(),
+        ]);
+    }
+
+    public function show(string $movieId)
+    {
+        $item = DtiItem::where('movie_id', $movieId)->firstOrFail();
+
+        $related = DtiItem::where('site_name', $item->site_name)
+            ->whereKeyNot($item->getKey())
+            ->orderByDesc('release_date')
+            ->orderByDesc('published_at')
+            ->limit(6)
+            ->get();
+
+        return view('works.show', [
+            'item' => $item,
+            'related' => $related,
+        ]);
+    }
+
+    public function site(string $slug)
+    {
+        $siteName = DtiItem::siteNameForSlug($slug);
+
+        abort_if($siteName === null, 404);
+
+        $items = DtiItem::where('site_name', $siteName)
+            ->orderByDesc('release_date')
+            ->orderByDesc('published_at')
+            ->paginate(48)
+            ->withQueryString();
+
+        abort_if($items->isEmpty(), 404);
+
+        return view('sites.show', [
+            'siteName' => $siteName,
+            'slug' => $slug,
+            'items' => $items,
+        ]);
     }
 }
diff --git a/app/Models/DtiItem.php b/app/Models/DtiItem.php
index 7490253..15e8d87 100644
--- a/app/Models/DtiItem.php
+++ b/app/Models/DtiItem.php
@@ -3,9 +3,21 @@
 namespace App\Models;
 
 use Illuminate\Database\Eloquent\Model;
+use Illuminate\Support\Collection;
 
 class DtiItem extends Model
 {
+    /**
+     * Site names arrive from the feed in Japanese, which would percent-encode into
+     * unreadable URLs, so each one gets a stable ASCII slug.
+     */
+    public const SITE_SLUGS = [
+        'カリビアンコム' => 'caribbeancom',
+        'カリビアンコムプレミアム' => 'caribbeancompr',
+        'HEYZO' => 'heyzo',
+        'Hey動画' => 'heydouga',
+    ];
+
     protected $fillable = [
         'guid',
         'source',
@@ -32,4 +44,48 @@ public function hasSampleVideo(): bool
     {
         return $this->sample_media_type === 'mp4' && filled($this->sample_mp4_url);
     }
+
+    public function url(): string
+    {
+        return url('/works/'.$this->movie_id);
+    }
+
+    public function siteSlug(): ?string
+    {
+        return self::SITE_SLUGS[$this->site_name] ?? null;
+    }
+
+    public function siteUrl(): string
+    {
+        $slug = $this->siteSlug();
+
+        return $slug === null ? url('/') : url('/sites/'.$slug);
+    }
+
+    public static function siteNameForSlug(string $slug): ?string
+    {
+        return array_search($slug, self::SITE_SLUGS, true) ?: null;
+    }
+
+    /**
+     * @return Collection<int, array{name: string, slug: string, url: string, count: int}>
+     */
+    public static function siteSummaries(): Collection
+    {
+        return static::query()
+            ->selectRaw('site_name, count(*) as items_count')
+            ->whereNotNull('site_name')
+            ->where('site_name', '<>', '')
+            ->groupBy('site_name')
+            ->orderByDesc('items_count')
+            ->get()
+            ->filter(fn ($row) => isset(self::SITE_SLUGS[$row->site_name]))
+            ->map(fn ($row) => [
+                'name' => $row->site_name,
+                'slug' => self::SITE_SLUGS[$row->site_name],
+                'url' => url('/sites/'.self::SITE_SLUGS[$row->site_name]),
+                'count' => (int) $row->items_count,
+            ])
+            ->values();
+    }
 }
