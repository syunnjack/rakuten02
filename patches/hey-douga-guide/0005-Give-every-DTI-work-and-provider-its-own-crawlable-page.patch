+++ b/tests/Feature/CrawlablePagesTest.php
@@ -0,0 +1,103 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Models\DtiItem;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Tests\TestCase;
+
+class CrawlablePagesTest extends TestCase
+{
+    use RefreshDatabase;
+
+    private function makeItem(array $attributes = []): DtiItem
+    {
+        static $sequence = 0;
+        $sequence++;
+
+        return DtiItem::create(array_merge([
+            'guid' => 'guid-'.$sequence,
+            'source' => 'csv',
+            'movie_id' => '10000'.$sequence,
+            'site_name' => 'カリビアンコム',
+            'title' => '作品タイトル '.$sequence,
+            'description' => '作品の説明文 '.$sequence,
+            'actor_name' => '出演者 '.$sequence,
+            'affiliate_url' => 'https://click.dtiserv2.com/Direct/162667/example/'.$sequence,
+            'page_url' => 'https://www.caribbeancom.com/moviepages/010101-00'.$sequence.'/index.html',
+            'sample_mp4_url' => 'https://smovie.caribbeancom.com/sample/movies/010101-00'.$sequence.'/sample_m.mp4',
+            'image_url' => 'https://www.caribbeancom.com/moviepages/010101-00'.$sequence.'/images/l_l.jpg',
+            'sample_media_type' => 'mp4',
+            'release_date' => '2026-01-0'.min($sequence, 9),
+        ], $attributes));
+    }
+
+    public function test_the_home_page_links_to_work_and_site_pages(): void
+    {
+        $item = $this->makeItem();
+
+        $this->get('/')
+            ->assertOk()
+            ->assertSee('https://sosoru.org/works/'.$item->movie_id, false)
+            ->assertSee('https://sosoru.org/sites/caribbeancom', false);
+    }
+
+    public function test_a_work_page_self_canonicalises_and_describes_the_video(): void
+    {
+        $item = $this->makeItem();
+
+        $this->get('/works/'.$item->movie_id)
+            ->assertOk()
+            ->assertSee('<link rel="canonical" href="https://sosoru.org/works/'.$item->movie_id.'">', false)
+            ->assertSee($item->title)
+            ->assertSee($item->description)
+            ->assertSee('"@type":"VideoObject"', false)
+            ->assertSee($item->sample_mp4_url, false)
+            ->assertSee('rel="sponsored noopener"', false);
+    }
+
+    public function test_an_unknown_work_or_site_is_not_found(): void
+    {
+        $this->get('/works/does-not-exist')->assertNotFound();
+        $this->get('/sites/does-not-exist')->assertNotFound();
+        $this->get('/sites/heyzo')->assertNotFound();
+    }
+
+    public function test_site_pages_paginate_without_a_page_1_duplicate(): void
+    {
+        foreach (range(1, 49) as $ignored) {
+            $this->makeItem();
+        }
+
+        $this->get('/sites/caribbeancom')
+            ->assertOk()
+            ->assertSee('<link rel="canonical" href="https://sosoru.org/sites/caribbeancom">', false)
+            ->assertSee('<link rel="next" href="https://sosoru.org/sites/caribbeancom?page=2">', false)
+            ->assertDontSee('sites/caribbeancom?page=1', false);
+
+        $this->get('/sites/caribbeancom?page=2')
+            ->assertOk()
+            ->assertSee('<link rel="canonical" href="https://sosoru.org/sites/caribbeancom?page=2">', false)
+            ->assertSee('<link rel="prev" href="https://sosoru.org/sites/caribbeancom">', false);
+
+        $this->get('/sites/caribbeancom?page=3')->assertNotFound();
+    }
+
+    public function test_the_sitemap_lists_every_work_and_site_page(): void
+    {
+        $items = collect(range(1, 3))->map(fn () => $this->makeItem());
+        $heyzo = $this->makeItem(['site_name' => 'HEYZO']);
+
+        $response = $this->get('/sitemap.xml')->assertOk();
+        $body = $response->getContent();
+
+        $this->assertStringContainsString('<loc>https://sosoru.org</loc>', $body);
+        $this->assertStringContainsString('<loc>https://sosoru.org/sites/caribbeancom</loc>', $body);
+        $this->assertStringContainsString('<loc>https://sosoru.org/sites/heyzo</loc>', $body);
+        $this->assertStringNotContainsString('page=2', $body);
+
+        foreach ($items->push($heyzo) as $item) {
+            $this->assertStringContainsString('<loc>https://sosoru.org/works/'.$item->movie_id.'</loc>', $body);
+        }
+    }
+}
