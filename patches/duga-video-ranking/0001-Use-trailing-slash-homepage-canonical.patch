-  <link rel="canonical" href="{{ url()->current() }}">
+  <link rel="canonical" href="{{ request()->is('/') ? rtrim(config('app.url'), '/').'/' : url()->current() }}">
   <meta property="og:site_name" content="DUGA人気ランキング">
   <meta property="og:type" content="website">
   <meta property="og:title" content="{{ $genreLabel ? $genreLabel.'動画ランキング｜DUGA人気動画まとめ' : 'DUGA人気ランキング｜マイリスト登録数で見る人気動画まとめ' }}">
