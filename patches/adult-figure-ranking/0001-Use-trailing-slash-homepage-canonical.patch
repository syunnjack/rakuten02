Date: Thu, 13 Aug 2026 17:08:54 +0000
Subject: [PATCH] Use trailing slash homepage canonical

---
 resources/views/welcome.blade.php | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/resources/views/welcome.blade.php b/resources/views/welcome.blade.php
index f00ae3e..a3bb6f8 100644
--- a/resources/views/welcome.blade.php
+++ b/resources/views/welcome.blade.php
@@ -6,7 +6,7 @@
   <meta name="viewport" content="width=device-width, initial-scale=1">
   <title>アダルトフィギュア新着まとめ｜FANZA最新フィギュア情報</title>
   <meta name="description" content="FANZAのアダルトフィギュアの新着情報を、発売日順にいち早くチェックできます。18歳未満閲覧禁止。">
-  <link rel="canonical" href="{{ url()->current() }}">
+  <link rel="canonical" href="{{ request()->is('/') ? rtrim(config('app.url'), '/').'/' : url()->current() }}">
   <meta property="og:site_name" content="アダルトフィギュア新着まとめ">
   <meta property="og:type" content="website">
   <meta property="og:title" content="アダルトフィギュア新着まとめ｜FANZA最新フィギュア情報">
