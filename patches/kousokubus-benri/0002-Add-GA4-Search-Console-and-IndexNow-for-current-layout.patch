diff --git a/.github/workflows/indexnow.yml b/.github/workflows/indexnow.yml
new file mode 100644
index 0000000..f76a538
--- /dev/null
+++ b/.github/workflows/indexnow.yml
@@ -0,0 +1,33 @@
+name: IndexNow
+
+on:
+  push:
+    branches:
+      - main
+  workflow_dispatch:
+
+jobs:
+  submit:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Wait for deployment
+        run: |
+          set +e
+          for i in $(seq 1 30); do
+            if curl -fsS https://busselect.jp/sitemap.xml | grep -q '<url>'; then
+              echo "Deployment ready"
+              exit 0
+            fi
+            echo "Waiting for deployment... ($i/30)"
+            sleep 20
+          done
+          echo "Timed out waiting for deployment; submitting URLs anyway"
+
+      - name: Submit URLs to IndexNow
+        env:
+          INDEXNOW_KEY: ${{ secrets.INDEXNOW_KEY }}
+        run: |
+          KEY="${INDEXNOW_KEY:-busselectindex2026}"
+          curl -fsS -X POST "https://api.indexnow.org/indexnow" \
+            -H "Content-Type: application/json; charset=utf-8" \
+            -d "{\"host\":\"busselect.jp\",\"key\":\"${KEY}\",\"keyLocation\":\"https://busselect.jp/${KEY}.txt\",\"urlList\":[\"https://busselect.jp/\",\"https://busselect.jp/routes\"]}"
diff --git a/app/layout.tsx b/app/layout.tsx
index c391be3..c3f01d9 100644
--- a/app/layout.tsx
+++ b/app/layout.tsx
@@ -1,6 +1,10 @@
 import type { Metadata } from "next";
+import Script from "next/script";
 import "./globals.css";
 
+const gaId = process.env.NEXT_PUBLIC_GOOGLE_ANALYTICS_MEASUREMENT_ID;
+const gscToken = process.env.NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION;
+
 export const metadata: Metadata = {
   metadataBase: new URL("https://busselect.jp"),
   title: { default: "NOLU | 高速バスを、価格だけで選ばない。", template: "%s | NOLU" },
@@ -8,8 +12,21 @@ export const metadata: Metadata = {
   alternates: { canonical: "/" },
   openGraph: { title: "NOLU by BUSSELECT", description: "高速バスを、価格だけで選ばない。", locale: "ja_JP", type: "website", url: "/" },
   robots: { index: true, follow: true },
+  ...(gscToken ? { verification: { google: gscToken } } : {}),
 };
 
 export default function RootLayout({ children }: Readonly<{ children: React.ReactNode }>) {
-  return <html lang="ja"><body>{children}</body></html>;
+  return (
+    <html lang="ja">
+      <head>
+        {gaId ? (
+          <>
+            <Script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
+            <Script id="ga4-init">{`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${gaId}');`}</Script>
+          </>
+        ) : null}
+      </head>
+      <body>{children}</body>
+    </html>
+  );
 }
